# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

# GitHub Pages production output
/dist-pages/

# Generated local caches
*.tsbuildinfo
__pycache__/
*.pyc

# Standalone weather build
/dist-weather/

# Local voice pilot usage counter (no credentials)
**/daily-usage.local.json*

# Private support inbox data (never publish reports or rate-limit keys)
**/support.sqlite3*
**/rate-limit.key
/deploy/support/data/

# Generated satellite tile cache
/deploy/satellite/tile-cache/
/deploy/satellite/cache/
